# Образец для живой проверки (src/internal/tunnel/live_test.go).
# Скопируйте в .env и впишите свой сервер: .env в хранилище не попадает.
# Без HOTPIPE_LIVE_HOST живая проверка пропускается.
#
# Соответствует: ssh -p 2222 -N -L <свободный порт>:127.0.0.1:3306 deploy@db.example.com
# Вход — по ключу без парольной фразы, как и у самого сервера HotPipe.
HOTPIPE_LIVE_HOST=db.example.com
HOTPIPE_LIVE_PORT=2222
HOTPIPE_LIVE_USER=deploy
HOTPIPE_LIVE_REMOTE_HOST=127.0.0.1
HOTPIPE_LIVE_REMOTE_PORT=3306
